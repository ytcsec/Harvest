# dependencies
node_modules/

# build output
dist/
out/
target/
*.tsbuildinfo
.next/
next-env.d.ts

# circuit artefacts -- rebuilt with `npm run circuit:build`.
# Three kinds are kept rather than ignored: the witness .wasm, the verification
# keys, and the final proving keys. The verifier contracts are set up against
# those keys, so they are part of the deployment rather than a build by-product,
# and a clone can prove without rerunning the setup. The intermediate .zkey from
# phase 2, the .r1cs and the .sym really are by-products.
.ptau/
circuits/build/*.zkey
!circuits/build/*_final.zkey
circuits/build/*.r1cs
circuits/build/*.sym
packages/frontend/public/zk/*.zkey
packages/frontend/public/zk/*.wasm

# secrets and local state -- the issuer signing key and the demo farmers'
# Stellar secret keys live here. `npm run deploy` regenerates them.
.harvest/
.env
.env.local

# misc
*.log
.DS_Store
Thumbs.db
contracts/test_snapshots/
